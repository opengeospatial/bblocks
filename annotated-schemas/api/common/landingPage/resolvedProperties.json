{"defs":{},"properties":[{"path":["title"],"id":"http://purl.org/dc/terms/title","title":"The title of the API.","description":"While a title is not required, implementers are strongly advised to include one.","schema_type":"string","sources":["bblocks://ogc.api.common.part1.schemas.landingPage"],"effectiveId":"http://purl.org/dc/terms/title"},{"path":["description"],"id":"http://purl.org/dc/terms/description","schema_type":"string","sources":["bblocks://ogc.api.common.part1.schemas.landingPage"],"effectiveId":"http://purl.org/dc/terms/description"},{"path":["attribution"],"title":"attribution for the API","description":"The `attribution` should be short and intended for presentation to a user, for example, in a corner of a map. Parts of the text can be links to other resources if additional information is needed. The string can include HTML markup.","schema_type":"string","sources":["bblocks://ogc.api.common.part1.schemas.landingPage"]},{"path":["links"],"required":true,"schema_type":"array","sources":["bblocks://ogc.api.common.part1.schemas.landingPage"]},{"path":["links","href"],"id":"http://www.w3.org/ns/oa#hasTarget","jsonld_type":"@id","description":"Supplies the URI to a remote resource (or resource fragment).","required":true,"schema_type":"string","sources":["bblocks://ogc.api.common.part1.schemas.link"],"effectiveId":"http://www.w3.org/ns/oa#hasTarget"},{"path":["links","rel"],"id":"http://www.iana.org/assignments/relation","jsonld_type":"@id","description":"The type or semantics of the relation.","required":true,"schema_type":"string","sources":["bblocks://ogc.api.common.part1.schemas.link"],"effectiveId":"http://www.iana.org/assignments/relation"},{"path":["links","type"],"id":"http://purl.org/dc/terms/type","description":"A hint indicating what the media type of the result of dereferencing the link should be.","schema_type":"string","sources":["bblocks://ogc.api.common.part1.schemas.link"],"effectiveId":"http://purl.org/dc/terms/type"},{"path":["links","hreflang"],"id":"http://purl.org/dc/terms/language","description":"A hint indicating what the language of the result of dereferencing the link should be.","schema_type":"string","sources":["bblocks://ogc.api.common.part1.schemas.link"],"effectiveId":"http://purl.org/dc/terms/language"},{"path":["links","title"],"id":"http://www.w3.org/2000/01/rdf-schema#label","description":"Used to label the destination of a link such that it can be used as a human-readable identifier.","schema_type":"string","sources":["bblocks://ogc.api.common.part1.schemas.link"],"effectiveId":"http://www.w3.org/2000/01/rdf-schema#label"},{"path":["links","length"],"id":"http://purl.org/dc/terms/extent","schema_type":"integer","sources":["bblocks://ogc.api.common.part1.schemas.link"],"effectiveId":"http://purl.org/dc/terms/extent"}]}